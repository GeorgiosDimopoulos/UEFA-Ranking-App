@page "/championsKnockouts"

@using API.Data.DTOs
@using Core.Models
@using UI.Clients
@using UI.Components.Pages.Components

@inject MatchesClient MatchesClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<h3>ChampionsLeague Knockouts</h3>

<MudGrid Spacing="4" Justify="Justify.SpaceEvenly">
    <MudItem Class="d-flex flex-column align-start">
        <MudText Typo="Typo.h6" Class="mb-3">
            Playoffs
        </MudText>
        @if (playoffs is not null)
        {
            @foreach (var match in playoffs)
            {
                var returnMatch = playoffs.FirstOrDefault(m => m.HomeTeamName == match.AwayTeamName && m.AwayTeamName == match.HomeTeamName);
                if (returnMatch is not null && match.Id > returnMatch.Id)
                {
                    continue;
                }
                <MudPaper Class="pa-3 mb-4">
                    <div style="display:grid; grid-template-columns: max-content 28px 28px; gap:12px; align-items:start;">
                        <div class="text-start">
                            <div>@match.HomeTeamName </div>
                            <div class="mt-2">@match.AwayTeamName</div>
                        </div>
                        <div class="text-center">
                            <div>@GetHomeGoals(match)</div>
                            <div class="mt-2">@GetAwayGoals(match)</div>
                            @if (match is not null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => EditMatch(match)" />
                            }
                        </div>
                        <div class="text-center">
                            <div>@GetAwayGoals(returnMatch)</div>
                            <div class="mt-2">@GetHomeGoals(returnMatch)</div>
                            @if (returnMatch is not null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => EditMatch(returnMatch)" />
                            }
                        </div>
                    </div>
                </MudPaper>
            }
        }
    </MudItem>
    <MudItem Class="d-flex flex-column align-start">
        <MudText Typo="Typo.h6" Class="mb-3">
            Round of 16
        </MudText>
        @if (roundOf16matches is not null)
        {
            @foreach (var match in roundOf16matches)
            {
                var returnMatch = roundOf16matches.FirstOrDefault(m => m.HomeTeamName == match.AwayTeamName && m.AwayTeamName == match.HomeTeamName);
                if (returnMatch is not null && match.Id > returnMatch.Id)
                {
                    continue;
                }
                <MudPaper Class="pa-3 mb-4">
                    <div style="display:grid; grid-template-columns: 1fr 35px 35px; gap:12px; align-items:start;">
                        <div class="text-start">
                            <div>@match.HomeTeamName </div>
                            <div class="mt-2">@match.AwayTeamName</div>
                        </div>
                        <div class="text-center">
                            <div>@GetHomeGoals(match)</div>
                            <div class="mt-2">@GetAwayGoals(match)</div>
                            @if (match is not null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => EditMatch(match)" />
                            }
                        </div>
                        <div class="text-center">
                            <div>@GetAwayGoals(returnMatch)</div>
                            <div class="mt-2">@GetHomeGoals(returnMatch)</div>
                            @if (returnMatch is not null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => EditMatch(returnMatch)" />
                            }
                        </div>
                    </div>
                </MudPaper>
            }
        }
    </MudItem>
    <MudItem Class="d-flex flex-column align-start">
        <MudText Typo="Typo.h6" Class="mb-3">
            Quarter Finals
        </MudText>
        @if (quartermatches is not null)
        {
            @foreach (var match in quartermatches)
            {
                var returnMatch = quartermatches.FirstOrDefault(m => m.HomeTeamName == match.AwayTeamName && m.AwayTeamName == match.HomeTeamName);
                if (returnMatch is not null && match.Id > returnMatch.Id)
                {
                    continue;
                }
                <MudPaper Class="pa-3 mb-4">
                    <div style="display:grid; grid-template-columns: 1fr 35px 35px; gap:12px; align-items:start;">
                        <div class="text-start">
                            <div>@match.HomeTeamName </div>
                            <div class="mt-2">@match.AwayTeamName</div>
                        </div>
                        <div class="text-center">
                            <div>@GetHomeGoals(match)</div>
                            <div class="mt-2">@GetAwayGoals(match)</div>
                            @if (match is not null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => EditMatch(match)" />
                            }
                        </div>
                        <div class="text-center">
                            <div>@GetAwayGoals(returnMatch)</div>
                            <div class="mt-2">@GetHomeGoals(returnMatch)</div>
                            @if (returnMatch is not null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => EditMatch(returnMatch)" />
                            }
                        </div>
                    </div>
                </MudPaper>
            }
        }
    </MudItem>
    <MudItem Class="d-flex flex-column align-start">
        <MudText Typo="Typo.h6" Class="mb-3">
            Semi Finals
        </MudText>
        @if (semifinals is not null)
        { @foreach (var match in semifinals)
            {
                var returnMatch = semifinals.FirstOrDefault(m => m.HomeTeamName == match.AwayTeamName && m.AwayTeamName == match.HomeTeamName);
                if (returnMatch is not null && match.Id > returnMatch.Id)
                {
                    continue;
                }
                <MudPaper Class="pa-3 mb-4">
                    <div style="display:grid; grid-template-columns: 1fr 35px 35px; gap:12px; align-items:start;">
                        <div class="text-start">
                            <div>@match.HomeTeamName </div>
                            <div class="mt-2">@match.AwayTeamName</div>
                        </div>
                        <div class="text-center">
                            <div>@GetHomeGoals(match)</div>
                            <div class="mt-2">@GetAwayGoals(match)</div>
                            @if (match is not null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => EditMatch(match)" />
                            }
                        </div>
                        <div class="text-center">
                            <div>@GetAwayGoals(returnMatch)</div>
                            <div class="mt-2">@GetHomeGoals(returnMatch)</div>
                            @if (returnMatch is not null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => EditMatch(returnMatch)" />
                            }
                        </div>
                    </div>
                </MudPaper>
            }
        }
    </MudItem>
    <MudItem xs="12" sm="6" md="2" Class="d-flex flex-column align-start">
        <MudText Typo="Typo.h6" Class="mb-3">
            Finals
        </MudText>
        <MudPaper Class="pa-3 mb-4">
            <div class="d-flex justify-space-between">
                <span>@finalmatch?.HomeTeamName </span>
                <span>@GetHomeGoals(finalmatch)</span>
            </div>
            <div class="d-flex justify-space-between mt-2">
                <span>@finalmatch?.AwayTeamName</span>
                <span>@GetAwayGoals(finalmatch)</span>
            </div>
            @if (finalmatch is not null)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => EditMatch(finalmatch)" />
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private List<MatchResponse> _allMatches = [];
    private List<MatchResponse> playoffs = [];
    private List<MatchResponse> roundOf16matches = [];
    private List<MatchResponse> quartermatches = [];
    private List<MatchResponse> semifinals = [];
    private MatchResponse? finalmatch = default!;

    protected override async Task OnInitializedAsync()
    {
        var allMatches = await MatchesClient.GetMatches();
        if (allMatches is null)
            return;

        _allMatches = allMatches.ToList();

        playoffs = _allMatches.Where(m => m.Round == Round.PlayOffs && m.Competition == Competition.ChampionsLeague).ToList();
        roundOf16matches = _allMatches.Where(m => m.Round == Round.RoundOf16 && m.Competition == Competition.ChampionsLeague).ToList();
        quartermatches = _allMatches.Where(m => m.Round == Round.Quarter && m.Competition == Competition.ChampionsLeague).ToList();
        semifinals = _allMatches.Where(m => m.Round == Round.SemiFinals && m.Competition == Competition.ChampionsLeague).ToList();
        finalmatch = _allMatches.FirstOrDefault(m => m.Round == Round.Final && m.Competition == Competition.ChampionsLeague);
    }

    private string GetHomeGoals(MatchResponse? matchResponse)
    {
        if (matchResponse is null)
            return "-";
        if (string.IsNullOrWhiteSpace(matchResponse.Score))
            return "-";

        return matchResponse.Score.Split('-')[0].Trim();
    }

    private string GetAwayGoals(MatchResponse? matchResponse)
    {
        if (matchResponse is null)
            return "-";
        if (string.IsNullOrWhiteSpace(matchResponse.Score))
            return "-";

        return matchResponse.Score.Split('-')[1].Trim();
    }

    private async Task EditMatch(MatchResponse match)
    {
        var parameters = new DialogParameters
        {
            ["Match"] = match
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<MatchDetails>("Edit Match", parameters, options);

        var result = dialog.Result;

        if (result is not null && result.IsCompletedSuccessfully && result.IsCanceled == false)
        {
        }
    }
}
