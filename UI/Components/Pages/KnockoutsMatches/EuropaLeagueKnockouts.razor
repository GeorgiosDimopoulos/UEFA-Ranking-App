@page "/europaKnockouts"
@using API.Data.DTOs
@using Core.Models
@using UI.Clients

@inject MatchesClient MatchesClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<h3>EuropaLeague Knockouts</h3>

<MudGrid>
    <MudItem xs="12" md="3">
        <MudText Typo="Typo.h6" Class="mb-3">
            Round of 16
        </MudText>
        @if (roundOf16matches is not null)
        {
            @foreach (var match in roundOf16matches)
            {
                <MudPaper Class="pa-3 mb-4">
                    <div class="d-flex justify-space-between">
                        <span>@match.HomeTeamName </span>
                        <span>@GetHomeGoals(match)</span>
                    </div>
                    <div class="d-flex justify-space-between mt-2">
                        <span>@match.AwayTeamName</span>
                        <span>@GetAwayGoals(match)</span>
                    </div>
                </MudPaper>
            }
        }

    </MudItem>
    <MudItem xs="12" md="3">
        <MudText Typo="Typo.h6" Class="mb-3">
            Quarter Finals
        </MudText>
        @if (quartermatches is not null)
        {
            @foreach (var match in quartermatches)
            {
                <MudPaper Class="pa-3 mb-4">
                    <div class="d-flex justify-space-between">
                        <span>@match.HomeTeamName </span>
                        <span>@GetHomeGoals(match)</span>
                    </div>
                    <div class="d-flex justify-space-between mt-2">
                        <span>@match.AwayTeamName</span>
                        <span>@GetAwayGoals(match)</span>
                    </div>
                </MudPaper>
            }
        }
    </MudItem>
    <MudItem xs="12" md="3">
        <MudText Typo="Typo.h6" Class="mb-3">
            Semi Finals
        </MudText>
        @if (semifinals is not null)
        { @foreach (var match in semifinals)
            {
                <MudPaper Class="pa-3 mb-4">
                    <div class="d-flex justify-space-between">
                        <span>@match.HomeTeamName </span>
                        <span>@GetHomeGoals(match)</span>
                    </div>
                    <div class="d-flex justify-space-between mt-2">
                        <span>@match.AwayTeamName</span>
                        <span>@GetAwayGoals(match)</span>
                    </div>
                </MudPaper>
            }
        }
    </MudItem>
    <MudItem xs="12" md="3">
        <MudText Typo="Typo.h6" Class="mb-3">
            Finals
        </MudText>
        <MudPaper Class="pa-3 mb-4">
            <div class="d-flex justify-space-between">
                <span>@finalmatch?.HomeTeamName </span>
                <span>@GetHomeGoals(finalmatch)</span>
            </div>
            <div class="d-flex justify-space-between mt-2">
                <span>@finalmatch?.AwayTeamName</span>
                <span>@GetAwayGoals(finalmatch)</span>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private List<MatchResponse> _allMatches = [];
    private List<MatchResponse> roundOf16matches = [];
    private List<MatchResponse> quartermatches = [];
    private List<MatchResponse> semifinals = [];
    private MatchResponse finalmatch = new();

    protected override async Task OnInitializedAsync()
    {
        _allMatches = await MatchesClient.GetMatches() ?? new();
        roundOf16matches = _allMatches.Where(m => m.Round == Round.RoundOf16 && m.Competition == Competition.EuropaLeague).ToList();
        quartermatches = _allMatches.Where(m => m.Round == Round.Quarter && m.Competition == Competition.EuropaLeague).ToList();
        semifinals = _allMatches.Where(m => m.Round == Round.SemiFinals && m.Competition == Competition.EuropaLeague).ToList();
        finalmatch = _allMatches.FirstOrDefault(m => m.Round == Round.Final && m.Competition == Competition.EuropaLeague) ?? new();
    }

    private string GetHomeGoals(MatchResponse? matchResponse)
    {
        if (matchResponse is null)
            return "-";
        if (string.IsNullOrWhiteSpace(matchResponse.Score))
            return "-";

        return matchResponse.Score.Split('-')[0].Trim();
    }

    private string GetAwayGoals(MatchResponse? matchResponse)
    {
        if (matchResponse is null)
            return "-";
        if (string.IsNullOrWhiteSpace(matchResponse.Score))
            return "-";

        return matchResponse.Score.Split('-')[1].Trim();
    }
}
