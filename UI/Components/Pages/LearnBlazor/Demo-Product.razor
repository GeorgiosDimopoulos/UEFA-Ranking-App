@page "/learnBlazor/demo-product"

<h2 class="text-primary">DemoProduct</h2>

<div class="p-2 mt-2">
	<p> Favourite count: @FavouritesCount </p>
	<p> Selected property is: @SelectedPropertyName </p>
	<div class="row">
		@foreach (var prod in products)
		{
			<_InnerProductComponent Product="prod" OnFavouriteUpdated="FavouriteCountChange" OnProductClicked="ProductClicked">
			</_InnerProductComponent>
		}
	</div>
	<div class="row pt-4">
		Count : @count
		<br />
		<input type="button" class="btn btn-success" style="width:100px" value="Count" />
	</div>
</div>

@code {
	private string selectedProp = string.Empty;
	private string selectedPropValue = string.Empty;
	private int count = 0;

	public int FavouritesCount { get; set; } = 0;
	public string SelectedPropertyName { get; set; } = string.Empty;

	List<Product> products = new();

	Product product = new()
	{
		Name = "Test product 1",
		IsActive = false,
		Id = 1,
		Price = 5,
		ProductProperties = new List<Product_Prop>()
		{
			new() { Id = 1, Key = "Color", Value = "Red" },
			new() { Id = 1, Key = "Size", Value = "20oz" },
			new() { Id = 1, Key = "Flavor", Value = "Rose" }
		}
	};

	protected override void OnInitialized()
	{
		base.OnInitialized();

		products.Add(new()
		{
			Name = "Test product 1",
			IsActive = false,
			Id = 1,
			Price = 5,
			ProductProperties = new List<Product_Prop>()
			{
				new() { Id = 1, Key = "Color", Value = "Red" },
				new() { Id = 1, Key = "Size", Value = "20oz" },
				new() { Id = 1, Key = "Flavor", Value = "Rose" }
			}
		});
		products.Add(new()
		{
			Name = "Test Product 2",
			IsActive = true,
			Id = 2,
			Price = 10,
			ProductProperties = new List<Product_Prop>()
			{
				new() { Id = 1, Key = "Color", Value = "Blue" },
				new() { Id = 1, Key = "Size", Value = "32oz" },
				new() { Id = 1, Key = "Flavor", Value = "Ocean" }
			}
		});
	}

	protected void FavouriteCountChange(bool isSelected)
	{
		if (isSelected)
		{
			FavouritesCount++;
		}
		else
		{
			FavouritesCount--;
		}
	}

	protected void ProductClicked(string name)
	{
		if(string.IsNullOrEmpty(name))
		{
			return;
		}
		SelectedPropertyName = name;
	}
}
