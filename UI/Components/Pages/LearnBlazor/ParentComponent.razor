@page "/learnBlazor/parentcomponent"

<h3>Parent Component</h3>

<_ChildComponent Title="Title is from parent component" OnButtonClickEvent="ShowMessage" MessageForGrandChild="This content is passed from Parent Component to Grand Child Component">
	<ChildContent>This content is passed from Parent Component to Child Component using RenderFragment.</ChildContent>
	<ExtraChildContent>This content is passed from Parent Component to Extra Child Component using RenderFragment.</ExtraChildContent>
</_ChildComponent>

<p>@MessageText</p>

@code {
	public string MessageText = string.Empty;

	public void ShowMessage()
	{
		MessageText = "Button inside child Component was clicked!";
	}

}
