@page "/teams"
@using API.Data.DTOs
@using Humanizer
@using Infrastructure
@using Infrastructure.DataAccess
@using UI.Clients

@inject TeamsClient TeamsClient
@inject IDialogService DialogService

<PageTitle>Teams</PageTitle>

<div class="col-12">
	<MudAlert Severity="Severity.Info">This component demonstrates showing football teams statistics for 2025 - 2026</MudAlert>

	@if (_teams == null)
	{
		<p><em>Loading teams...</em></p>
	}
	else
	{
		<MudTable Items="_teams">
			<HeaderContent>
				<MudTh>Name</MudTh>
				<MudTh>Country</MudTh>
				<MudTh>Competition</MudTh>
				<MudTh>Position</MudTh>
				<MudTh>Points</MudTh>
				<MudTh>Is Active?</MudTh>
				<MudTh>Matches:</MudTh>
			</HeaderContent>
			<RowTemplate>
				<MudTd>
					@* <NavLink class="nav-link" href=@($"/teams/{context.Name}") style="text-decoration:underline">@context.Name</NavLink> *@
					<MudButton Variant="Variant.Text" Class="p-0" OnClick="() => OpenTeamAsync(context)">
						<span style="text-decoration:underline"> @context.Name </span>
					</MudButton>
				</MudTd>
				<MudTd>@context.CountryName</MudTd>
				<MudTd>@context.Competition.ToString().Humanize(LetterCasing.Title)</MudTd>
				<MudTd>@context.Position</MudTd>
				<MudTd>
					<MudNumericField T="int" @bind-value="context.Points" Style="width:60px;" Disabled="@(!context.IsActive)" />
				</MudTd>
				<MudTd>
					<MudCheckBox T="bool" @bind-Checked="@context.IsActive" />
				</MudTd>
				<MudTd>
					<MudButton Color="Color.Success"
							   Variant="Variant.Filled"
							   Style="min-width:40px; width:40px; height:30px; padding:0;"
							   OnClick="@(() => ShowMatches(context))">
						<MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
					</MudButton>
				</MudTd>
			</RowTemplate>
		</MudTable>
	}

</div>

@code
{
	private TeamResponse[]? _teams = default!;
	private CountryResponse[]? _countries = default!;

	protected override async Task OnInitializedAsync()
	{
		await Task.Delay(500);
		var data = await TeamsClient.GetTeams() ?? Array.Empty<TeamResponse>();
		_teams = data.OrderBy(t => t.Points).ToArray();
	}

	private void ShowMatches(TeamResponse t)
	{
	}

	private async Task OpenTeamAsync(TeamResponse t)
	{
		var parameters = new DialogParameters
		{
			["Team"] = t
		};

		var dialogRef = await DialogService.ShowAsync<TeamDetails>(t.Name, parameters, new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
		var result = await dialogRef.Result;
		if (result != null && !result!.Canceled && result.Data is TeamResponse updatedCountry)
		{
			StateHasChanged();
		}
	}
}
