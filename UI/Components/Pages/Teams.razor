@page "/teams"

@using API.Data.DTOs
@using Humanizer
@using Infrastructure
@using Infrastructure.DataAccess
@using UI.Clients
@using UI.Components.Pages.Components

@inject TeamsClient TeamsClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Teams</PageTitle>

<div class="col-12">
    @if (_teams == null)
    {
        <p><em>Loading teams...</em></p>
    }
    else
    {
        <MudTextField @bind-Value="_searchText" Label="Search teams..." Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        <MudTable Items="_teams">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Country</MudTh>
                <MudTh>Competition</MudTh>
                <MudTh>Position</MudTh>
                <MudTh>Points</MudTh>
                <MudTh>Is Active?</MudTh>
                <MudTh>Matches:</MudTh>
                <MudTh>Edit</MudTh>
                <MudTh>Delete</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Class="pl-4">
                    <MudButton Variant="Variant.Text" Class="p-0" OnClick="() => OpenTeamInfoAsync(context)">
                        <span style="text-decoration:underline"> @context.Name </span>
                    </MudButton>
                </MudTd>
                <MudTd>@context.CountryName</MudTd>
                <MudTd>@context.Competition.ToString().Humanize(LetterCasing.Title)</MudTd>
                <MudTd>@context.Position</MudTd>
                <MudTd>@context.Points</MudTd>
                <MudText T="int" @bind-value="context.Points" Style="width:60px;" Disabled="@(!context.IsActive)" />
                <MudCheckBox T="bool" Checked="@context.IsActive" Disabled="true" OnChanged="@( (bool? v) => context.IsActive = v == true )" />
                <MudTd>
                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               Style="min-width:40px; width:40px; height:30px; padding:0;"
                               OnClick="@(() => OpenTeamMatchesAsync(context))">
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                    </MudButton>
                </MudTd>
                <MudTd>
                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               Style="min-width:40px; width:40px; height:30px; padding:0;"
                               OnClick="@(() => OpenTeamInfoAsync(context))">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                    </MudButton>
                </MudTd>
                <MudTd>
                    <MudButton Color="Color.Error"
                               Variant="Variant.Filled"
                               Style="min-width:40px; width:40px; height:30px; padding:0;"
                               OnClick="@(() => DeleteTeamAsync(context))">
                        <MudIcon Icon="@Icons.Material.Filled.Delete" />
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

</div>

@code
{
    private string _searchText = string.Empty;

    private TeamResponse[]? _teams = default!;
    private CountryResponse[]? _countries = default!;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        var data = await TeamsClient.GetTeams() ?? Array.Empty<TeamResponse>();
        _teams = data.OrderByDescending(t => t.CountryPoints).ToArray();
    }

    private async Task OpenTeamInfoAsync(TeamResponse t)
    {
        var parameters = new DialogParameters
        {
            ["Team"] = t
        };

        var dialogRef = await DialogService.ShowAsync<TeamDetails>(t.Name, parameters, new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialogRef.Result;
        if (result != null && !result!.Canceled && result.Data is TeamResponse updatedCountry)
        {
            StateHasChanged();
        }

        await OnInitializedAsync();
    }

    private async Task OpenTeamMatchesAsync(TeamResponse team)
    {
        var parameters = new DialogParameters { ["Team"] = team };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await DialogService.ShowAsync<TeamMatches>("Team Matches", parameters, options);

        var result = await dialog.Result;
    }

    private async Task DeleteTeamAsync(TeamResponse t)
    {
        var teamReq = new TeamRequest
        {
            Name = t.Name,
            Competition = t.Competition,
            Id = t.Id,
            CountryName = t.CountryName,
            Points = t.Points,
            IsActive = t.IsActive
        };

        bool? confirmation = await DialogService.ShowMessageBox("Confirm Delete", $"Are you sure you want to delete the team: {teamReq.Name}", yesText: "Delete", cancelText: "Cancel");
        if (confirmation == true)
        {
            var result = await TeamsClient.DeleteTeam(teamReq.Id);
            if (result != null && result == true)
            {
                Snackbar.Add($"Team {teamReq.Name} deleted successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Failed to delete team {teamReq.Name}.", Severity.Error);
            }
        }

        await OnInitializedAsync();
    }
}
