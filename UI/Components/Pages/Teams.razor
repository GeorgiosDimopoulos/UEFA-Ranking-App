@page "/teams"
@using Core.Models
@using Humanizer
@using Infrastructure
@using Infrastructure.DataAccess

<PageTitle>Teams</PageTitle>

<div class="col-12">
	<div class="alert alert-info">This component demonstrates showing teams data.</div>

	@if (teams == null)
	{
		<p><em>Loading teams...</em></p>
	}
	else
	{
		<MudTable Items="teams">
			<HeaderContent>
				<MudTh>Id</MudTh>
				<MudTh>Name</MudTh>
				<MudTh>Competition</MudTh>
				<MudTh>Points</MudTh>
				<MudTh>Position</MudTh>
				<MudTh>Is Active?</MudTh>
				<MudTh>Matches:</MudTh>
			</HeaderContent>
			<RowTemplate>
				<MudTd>@context.Name</MudTd>
				<MudTd>@context.ExternalId</MudTd>
				<MudTd>@context.Country.Name</MudTd>
				<MudTd>@context.Competition.ToString().Humanize(LetterCasing.Title)</MudTd>
				<MudTd>@context.Position</MudTd>
				<MudTd>@context.Points</MudTd>
				<MudTd>
					<input type="number" @bind=@context.Points style="width:40px;" disabled="@(context.IsActive == false)" />
					<MudNumericField T="int"
									 @bind-value="context.Points"
									 Disabled="@(!context.IsActive)" />
				</MudTd>
				<MudTd>
					<MudCheckBox T="bool" @bind-Checked="@context.IsActive" />
				</MudTd>
				<MudTd>
					<MudButton Color="Color.Success"
							   Variant="Variant.Filled"
							   Style="min-width:40px; width:40px; height:30px; padding:0;"
							   OnClick="@(() => ShowMatches(context))" />
				</MudTd>
				<NavLink class="nav-link" href=@($"/teams/{context.Id}") style="text-decoration:underline">@context.Name</NavLink>
			</RowTemplate>
		</MudTable>
	}

</div>

@code
{
	private Team[]? teams = default!;

	protected override async Task OnInitializedAsync()
	{
		await Task.Delay(500);
		var databasefeeder = new DatabaseFeeder();
		teams = databasefeeder.GetTeams();
	}

	private void ShowMatches(Team t)
	{
	}
}
