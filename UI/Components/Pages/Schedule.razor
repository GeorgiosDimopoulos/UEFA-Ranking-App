@page "/schedule"
@page "/"

@using API.Data.DTOs
@using Humanizer
@using UI.Clients
@using UI.Components.Pages.Components

@inject MatchesClient MatchesClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<h3>Schedule</h3>

<div>
    @if (_matches is null)
    {
        <p><em>Loading Matches...</em></p>
    }
    else
    {
        <div class="d-flex justify-content-center mb-3 align-items-center gap-2">
            <MudButton Style="text-decoration:underline">PREVIOUS</MudButton>
            <MudText Style="font-weight:bold; text-align:center;">Round: 1</MudText>
            <MudButton Style="text-decoration:underline">NEXT</MudButton>
        </div>
        <MudTable Items="_matches">
            <HeaderContent>
                <MudTh Style="font-weight:bold;">Home Team</MudTh>
                <MudTh Style="font-weight:bold;">Away Team</MudTh>
                <MudTh Style="font-weight:bold;">Score</MudTh>
                <MudTh Style="font-weight:bold;">Competition</MudTh>
                @* <MudTh Style="font-weight:bold;">Round</MudTh> *@
                <MudTh Style="font-weight:bold;">Edit</MudTh>
                <MudTh Style="font-weight:bold;">Delete</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.HomeTeamName</MudTd>
                <MudTd>@context.AwayTeamName</MudTd>
                <MudTd>
                    @if (@context.Score is null)
                    {
                        @string.Empty
                    }
                    else
                    {
                        @context.Score
                    }
                </MudTd>
                <MudTd>@context.Competition.ToString().Humanize(LetterCasing.Title)</MudTd>
                @* <MudTd>@context.Round</MudTd> *@
                <MudTd Style="vertical-align: middle;">
                    <MudButton Class="p-0"
                               Color="Color.Success"
                               Variant="Variant.Filled"
                               Style="min-width:40px; width:40px; height:30px; display:flex;"
                               OnClick="() => EditMatch(context)">
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                    </MudButton>
                </MudTd>
                <MudTd Style="vertical-align: middle;">
                    <MudButton Color="Color.Error"
                               Variant="Variant.Filled"
                               Style="min-width:40px; width:40px; height:30px; display:flex;"
                               OnClick="@(() => DeleteMatchAsync(context))">
                        <MudIcon Icon="@Icons.Material.Filled.Delete" />
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</div>

@code {
    private List<MatchResponse> _matches = default!;

    protected override async Task OnInitializedAsync()
    {
        var matches = await MatchesClient.GetMatches() ?? new();
        _matches = matches.OrderBy(m => m.Competition)
                          .ThenBy(m=> m.Round)
                          .ToList();
    }

    private async Task DeleteMatchAsync(MatchResponse m)
    {
        bool? confirmation = await DialogService.ShowMessageBox("Confirm Delete", "Are you sure you want to delete the match?", yesText: "Delete", cancelText: "Cancel");
        
        if (confirmation == true)
        {
            var result = await MatchesClient.DeleteMatch(m.Id);
            if (result != null && result == true)
            {
                Snackbar.Add($"Match deleted successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Failed to delete Match", Severity.Error);
            }
        }

        await OnInitializedAsync();
    }

    private async Task EditMatch(MatchResponse match)
    {
        var parameters = new DialogParameters { ["Match"] = match };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await DialogService.ShowAsync<MatchDetails>("Edit Match", parameters, options);

        var result = await dialog.Result;
        if (result != null && !result!.Canceled && result.Data is MatchResponse mr)
        {
            var index = _matches.FindIndex(m => m.Id == mr.Id);
            if (index != -1)
            {
                _matches[index] = mr;
                StateHasChanged();
            }
        }
    }
}
