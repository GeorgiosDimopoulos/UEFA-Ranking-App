@page "/newCountry"
@using API.Data.DTOs
@using UI.Clients
@inherits ComponentBase
@inject IDialogService DialogService
@inject CountriesClient CountriesClient

<MudDialog>
    <DialogContent>
        <MudForm @ref="addForm" Spacing="2">
            <MudTextField @bind-Value="countryRes.Name" Label="Name" />
            <MudTextField @bind-Value="countryRes.TotalPoints" Label="Points" />
            <MudText Typo="Typo.body1">Initial Teams: @countryRes.NumberOfInitialTeams</MudText>
            <MudText Typo="Typo.body1">Active Teams: @countryRes.NumberOfActiveTeams</MudText>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm addForm = default!;
    private CountryResponse countryRes = new();
    private CountryRequest countryReq = new();
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    protected async override void OnParametersSet()
    {
        await Task.Delay(500);
    }

    private void Cancel(MouseEventArgs args)
    {
        MudDialog?.Close(DialogResult.Ok(countryRes));
    }

    private async Task Save(MouseEventArgs args)
    {
        countryReq = new CountryRequest
        {
            Name = countryRes.Name,
            TotalPoints = countryRes.TotalPoints
        };
        var success = await CountriesClient.AddCountry(countryReq);
    }
}
