@page "/newCountry"
@using API.Data.DTOs
@inherits ComponentBase
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudForm @ref="addForm" Spacing="2">
            <MudTextField @bind-Value="country.Name" Label="Name" />
            <MudTextField @bind-Value="country.TotalPoints" Label="Points" />
            <MudText Typo="Typo.body1">Initial Teams: @country.NumberOfInitialTeams</MudText>            
            <MudText Typo="Typo.body1">Active Teams: @country.NumberOfActiveTeams</MudText>            
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm addForm = default!;
    private CountryResponse country = new();
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    protected override void OnParametersSet()
    {
    }

    private void Cancel(MouseEventArgs args)
    {
        MudDialog?.Close(DialogResult.Ok(country));
    }

    private void Save(MouseEventArgs args)
    {

    }

    private void AddCompetition(MouseEventArgs args, int i)
    {

    }
}
