@page "/countries/{Id:guid}"

@inherits ComponentBase

@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject CountriesClient CountriesClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@using API.Data.DTOs
@using MudBlazor
@using UI.Clients

<MudDialog>
	<DialogContent>
		<MudForm @ref="editForm">
			<MudTextField @bind-Value="countryRes.Name" Label="Name" />
			<MudNumericField T="int" @bind-Value="countryRes.TotalPoints" Label="Total Points" />
			<MudStack Row="true">
				<MudTextField T="int" Disabled="true" Value="countryRes.Position" Label="Initial Position" />
				<MudTextField T="int" Disabled="true" Value="countryRes.Position" Label="Current Position" />
			</MudStack>
			<MudStack Row="true">
				<MudTextField T="int" Disabled="true" Value="countryRes.NumberOfInitialTeams" Label="Initial Teams" />
				<MudTextField T="int" Disabled="true" Value="countryRes.NumberOfActiveTeams" Label="Active Teams" />
			</MudStack>
		</MudForm>
	</DialogContent>
	<DialogActions>
		<MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
		<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[Parameter] public CountryResponse Country { get; set; } = default!;
	[CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

	private MudForm editForm = default!;
	private CountryResponse countryRes = new();
	private CountryRequest countryReq = new();

	protected override void OnParametersSet()
	{
		countryRes = new CountryResponse
		{
			Position = Country.Position,
			Id = Country.Id,
			Name = Country.Name,
			NumberOfActiveTeams = Country.NumberOfActiveTeams,
			NumberOfInitialTeams = Country.NumberOfInitialTeams,
			TotalPoints = Country.TotalPoints
		};
	}

	private async Task Save()
	{
		// var options = new DialogOptions { CloseOnEscapeKey = true };
		countryReq = new CountryRequest
		{
			Name = countryRes.Name,
			TotalPoints = countryRes.TotalPoints
		};

		var result = await CountriesClient.UpdateCountry(countryRes.Id, countryReq);
		if (result != null && result == false)
		{
			MudDialog?.Close(DialogResult.Ok(countryRes));
			Snackbar.Add("Failed to update country.", Severity.Error);
			return;
		}

		Snackbar.Add("Country updated successfully.", Severity.Success);
		MudDialog?.Close(DialogResult.Ok(countryRes));
		Navigation.NavigateTo("/countries");
	}

	private void Cancel()
	{
		MudDialog?.Close(DialogResult.Ok(countryRes));
	}
}