@page "/newTeam"
@using API.Data.DTOs
@using Core.Models
@using UI.Clients
@inherits ComponentBase
@inject IDialogService DialogService
@inject TeamsClient TeamsClient

<MudDialog>
    <DialogContent>
        <MudForm @ref="addForm" Spacing="2">
            <MudTextField @bind-Value="teamRes.Name" Label="Team Name" />
            <MudTextField @bind-Value="teamRes.CountryName" Label="Country" />
            <MudTextField @bind-Value="teamRes.Points" Label="Points" />
            <MudCheckBox @bind-value="teamRes.IsActive" Label="Active" />
            <div style="text-align: left;">
                <MudMenu Color="Color.Primary"
                         Variant="Variant.Filled"
                         Label="Competition"
                         StartIcon="@Icons.Material.Filled.Add"
                         Dense="true"
                         Class="m-1">
                    <MudMenuItem OnClick="@(args => AddCompetition(args, Competition.ChampionsLeague))">Champions League</MudMenuItem>
                    <MudMenuItem OnClick="@(args => AddCompetition(args, Competition.EuropaLeague))">Europa League</MudMenuItem>
                    <MudMenuItem OnClick="@(args => AddCompetition(args, Competition.ConferenceLeague))">Conference League</MudMenuItem>
                </MudMenu>
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm addForm = default!;
    private TeamResponse teamRes = new();
    private TeamRequest teamReq = new();
    private Competition Competition;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    protected override void OnParametersSet()
    {
    }

    private void Cancel(MouseEventArgs args)
    {
        MudDialog?.Close(DialogResult.Ok(teamRes));
    }

    private async Task Save(MouseEventArgs args)
    {
        teamReq = new TeamRequest
        {
            Name = teamRes.Name,
            CountryName = teamRes.CountryName,
            Points = teamRes.Points,
            Competition = Competition,
            IsActive = teamRes.IsActive
        };
        var success = await TeamsClient.AddTeam(teamReq);
    }

    private void AddCompetition(MouseEventArgs args, Competition c)
    {
        Competition = c;
    }
}
