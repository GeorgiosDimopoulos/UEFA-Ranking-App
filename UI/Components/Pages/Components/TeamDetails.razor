@page "/teams/{Id:guid}"

@using API.Controllers
@using API.Data.DTOs
@using Infrastructure.DataAccess
@using MudBlazor
@using UI.Clients
@using static MudBlazor.CategoryTypes

@inject IDialogService DialogService
@inject TeamsClient TeamsClient
@inject ISnackbar Snackbar
@inject CountriesClient CountriesClient
@inject NavigationManager Navigation
<MudDialog>
	<DialogContent>
		<MudForm>
			<MudTextField @bind-Value="teamRes.Name" Label="Name" />
			<MudSelect T="string" Label="Country" @bind-Value="teamRes.CountryName">
				@foreach (var c in countriesNames)
				{
					<MudSelectItem Value="@c">@c</MudSelectItem>
				}
			</MudSelect>
			<MudTextField T="int" @bind-Value="teamRes.Position" Label="Position" Disabled="true" />
			<MudTextField T="int" ReadOnly="true" HideSpinButtons="true" Value="teamRes.Matches?.Count ?? 0" Label="Matches" Disabled="true" />
			<MudTextField T="int" Value="teamRes.Points" Label="Points" Disabled="true" />
			<MudCheckBox @bind-value="teamRes.IsActive" Label="Active" />
		</MudForm>
	</DialogContent>
	<DialogActions>
		<MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
		<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[Parameter] public TeamResponse Team { get; set; } = default!;
	[CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

	private TeamResponse teamRes = new();
	private TeamRequest teamReq = new();

	private List<string> countriesNames = new();

	private string initialName = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		var countries = await CountriesClient.GetCountries();
		if (countries == null)
		{
			Snackbar.Add("Failed to load countries.", Severity.Error);
			return;
		}

		countriesNames = countries.Select(c => c.Name).ToList();
		initialName = Team.Name;

		teamRes = new TeamResponse
		{
			Position = Team.Position,
			Name = Team.Name,
			Points = Team.Points,
			Matches = Team.Matches,
			Competition = Team.Competition,
			CountryName = Team.CountryName,
			IsActive = Team.IsActive,
			Id = Team.Id,
			GoalsDifference = Team.GoalsDifference,
			MatchesPlayed = Team.MatchesPlayed
		};
	}

	private async Task Save()
	{
		var options = new DialogOptions { CloseOnEscapeKey = true };

		teamReq = new TeamRequest
		{
			Name = teamRes.Name,
			Points = teamRes.Points,
			Competition = teamRes.Competition,
			IsActive = teamRes.IsActive,
			CountryName = teamRes.CountryName
		};
		var success = await TeamsClient.UpdateTeam(teamReq, initialName);

		if (success != null && success == true)
		{
			MudDialog?.Close(DialogResult.Ok(teamRes));
			Snackbar.Add("Team updated successfully.", Severity.Success);
			Navigation.NavigateTo("/teams");
		}
		else
		{
			Snackbar.Add("Failed to update team.", Severity.Error);
		}
	}

	private void Cancel()
	{
		MudDialog?.Close(DialogResult.Ok(Team));
	}
}
