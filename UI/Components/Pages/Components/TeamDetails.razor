@page "/teams/{Id:guid}"

@using API.Data.DTOs
@using Infrastructure.DataAccess
@using MudBlazor
@using UI.Clients
@using static MudBlazor.CategoryTypes

@inject IDialogService DialogService
@inject TeamsClient TeamsClient
@inject ISnackbar Snackbar

<MudDialog>
	<DialogContent>
		<MudForm>
			<MudTextField @bind-Value="teamRes.Name" Label="Name" />
			<MudNumericField T="int" ReadOnly="true" HideSpinButtons="true" @bind-Value="teamRes.Position" Label="Initial Position" />
			<MudNumericField T="int" @bind-Value="teamRes.Position" Label="Current Position" />
			<MudNumericField T="int" ReadOnly="true" HideSpinButtons="true" Value="teamRes.Matches?.Count ?? 0" Label="Matches" />
			<MudNumericField T="int" Value="teamRes.Points" Label="Points" />
		</MudForm>
	</DialogContent>
	<DialogActions>
		<MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
		<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[Parameter] public TeamResponse Team { get; set; } = default!;
	[CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

	private TeamResponse teamRes = new();
	private TeamRequest teamReq = new();

	protected override void OnParametersSet()
	{
		teamRes = new TeamResponse
		{
			Position = Team.Position,
			Name = Team.Name,
			Points = Team.Points,
			Matches = Team.Matches,
			Competition = Team.Competition,
			CountryName = Team.CountryName
		};
	}

	private async Task Save()
	{
		var options = new DialogOptions { CloseOnEscapeKey = true };

		teamReq = new TeamRequest
		{
			Name = teamRes.Name,
			Points = teamRes.Points,
			Competition = teamRes.Competition,
			IsActive = teamRes.IsActive,
			CountryName = teamRes.CountryName
		};
		var success = await TeamsClient.UpdateTeam(teamReq);

		if (success != null && success == true)
		{
			MudDialog?.Close(DialogResult.Ok(teamRes));
			Snackbar.Add("Team updated successfully.", Severity.Success);
		}
		else
		{
			Snackbar.Add("Failed to update team.", Severity.Error);
		}
	}

	private void Cancel()
	{
		MudDialog?.Close(DialogResult.Ok(Team));
	}
}
