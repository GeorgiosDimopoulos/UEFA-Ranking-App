@page "/newMatch"

@using API.Data.DTOs
@using Core.Models
@using Humanizer
@using UI.Clients

@inherits ComponentBase

@inject IDialogService DialogService
@inject MatchesClient MatchClient
@inject TeamsClient TeamsClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudDialog>
    <DialogContent>
        <MudForm @ref="addForm" Spacing="2">
            <MudSelect T="Competition" Label="Competition" Value="matchRes.Competition" ValueChanged="OnCompetitionChanged">
                @foreach (var c in Enum.GetValues<Competition>())
                {
                    <MudSelectItem Value="@c">@c.ToString().Humanize(LetterCasing.Title)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Round" Label="Round" @bind-Value="matchRes.Round">
                @foreach (var r in Enum.GetValues<Round>())
                {
                    <MudSelectItem Value="@r">@r.ToString()</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Home Team" Value="matchRes.HomeTeamName" ValueChanged="OnHomeTeamChanged">
                @foreach (var tr in _competitionTeams)
                {
                    <MudSelectItem Value="@tr.Name">@tr.Name.Humanize(LetterCasing.Title)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Away Team" Value="matchRes.AwayTeamName" ValueChanged="OnAwayTeamChanged">
                @foreach (var tr in _competitionTeams)
                {
                    <MudSelectItem Value="@tr.Name">@tr.Name.Humanize(LetterCasing.Title)</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm addForm = default!;
    private MatchResponse matchRes = new();
    private MatchRequest matchReq = new();

    private List<TeamResponse> _teams = new();
    private List<TeamResponse> _competitionTeams = new();

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var data = await TeamsClient.GetTeams() ?? Array.Empty<TeamResponse>();
        _teams = data.OrderBy(c => c.Position).ToList();

        matchRes.Competition = GetCompetitionFromUrl();

        _competitionTeams = _teams.Where(t => t.Competition == matchRes.Competition)
                                  .OrderBy(t => t.Name)
                                  .ToList();
    }

    private Competition GetCompetitionFromUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (uri.AbsolutePath.Contains("champion", StringComparison.OrdinalIgnoreCase))
        {
            return Competition.ChampionsLeague;
        }
        else if (uri.AbsolutePath.Contains("europa", StringComparison.OrdinalIgnoreCase))
        {
            return Competition.EuropaLeague;
        }
        else if (uri.AbsolutePath.Contains("conference", StringComparison.OrdinalIgnoreCase))
        {
            return Competition.ConferenceLeague;
        }

        return Competition.None;
    }

    private void OnCompetitionChanged(Competition comp)
    {
        matchRes.Competition = comp;
        _competitionTeams = _teams.Where(t => t.Competition == comp)
                                        .OrderBy(t => t.Name)
                                        .ToList();

        matchRes.HomeTeamName = string.Empty;
        matchRes.AwayTeamName = string.Empty;
    }

    private void OnHomeTeamChanged(string homeTeam)
    {
        if ((!string.IsNullOrEmpty(matchRes.AwayTeamName)) && (!string.IsNullOrEmpty(homeTeam)))
        {
            if (AreTeamsSame(matchRes.AwayTeamName, homeTeam) || IsCompetitionNone(matchRes.Competition) || AreTeamsCountriesSame(homeTeam, matchReq.AwayTeamName, matchReq.Round))
                return;
        }

        matchRes.HomeTeamName = homeTeam;
    }

    private void OnAwayTeamChanged(string awayTeam)
    {
        if ((!string.IsNullOrEmpty(matchRes.HomeTeamName)) && (!string.IsNullOrEmpty(awayTeam)))
        {
            if (AreTeamsSame(matchRes.HomeTeamName, awayTeam) || IsCompetitionNone(matchRes.Competition) || AreTeamsCountriesSame(matchRes.HomeTeamName, awayTeam, matchReq.Round))
            {
                return;
            }
        }

        matchRes.AwayTeamName = awayTeam;
    }

    private async Task Save(MouseEventArgs args)
    {
        if (!AreFieldsFilled())
        {
            Snackbar.Add("Match cannot be added, fill all fields please!", Severity.Warning);
            return;
        }

        matchReq = new MatchRequest
        {
            HomeTeamName = matchRes.HomeTeamName,
            AwayTeamName = matchRes.AwayTeamName,
            Score = matchRes.Score,
            Round = matchRes.Round,
            Competition = matchRes.Competition
        };
        var success = await MatchClient.AddMatch(matchReq);

        if (success != null && success == true)
        {
            MudDialog.Close(DialogResult.Ok(matchRes));
            Snackbar.Add("Match added successfully.", Severity.Success);
            switch (matchReq.Competition)
            {
                case Competition.ChampionsLeague:
                    Navigation.NavigateTo("/championsSchedule", forceLoad: true);
                    break;
                case Competition.EuropaLeague:
                    Navigation.NavigateTo("/europaSchedule", forceLoad: true);
                    break;
                case Competition.ConferenceLeague:
                    Navigation.NavigateTo("/conferenceSchedule", forceLoad: true);
                    break;
                default:
                    Navigation.NavigateTo("/");
                    break;
            }

            await InvokeAsync(StateHasChanged);
        }
        else
        {
            Snackbar.Add("Failed to add match.", Severity.Error);
        }
    }

    private void Cancel(MouseEventArgs args)
    {
        MudDialog?.Close(DialogResult.Ok(matchRes));
    }

    private bool AreFieldsFilled()
    {
        if (matchRes.Round <= 0)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(matchRes.HomeTeamName) || string.IsNullOrWhiteSpace(matchRes.AwayTeamName) || matchRes.Competition == Competition.None)
        {
            return false;
        }

        return true;
    }

    private bool AreTeamsSame(string firstTeam, string secondTeam)
    {
        if (secondTeam.Equals(firstTeam))
        {
            Snackbar.Add("Home and Away teams cannot be the same.", Severity.Warning);
            matchRes.HomeTeamName = string.Empty;
            matchRes.AwayTeamName = string.Empty;

            return true;
        }
        return false;
    }

    private bool IsCompetitionNone(Competition comp)
    {
        if (matchRes.Competition == Competition.None)
        {
            Snackbar.Add("Please select a competition first.", Severity.Warning);
            matchRes.HomeTeamName = string.Empty;
            matchRes.AwayTeamName = string.Empty;

            return true;
        }
        return false;
    }

    private bool AreTeamsCountriesSame(string homeTeamName, string awayTeamName, Round round)
    {
        if ((int)round <= 0)
            return false;

        var team1 = _teams.FirstOrDefault(t => t.Name == homeTeamName);
        var team2 = _teams.FirstOrDefault(t => t.Name == awayTeamName);

        if (team1 is null || team2 is null)
            return false;

        if (team1.CountryName.Equals(team2?.CountryName) && AllowedMatchFromSameCountry(round) == false)
        {
            Snackbar.Add("Both teams cannot be from the same country on that round.", Severity.Warning);
            matchRes.HomeTeamName = string.Empty;
            matchRes.AwayTeamName = string.Empty;
            return true;
        }

        return false;
    }

    private bool AllowedMatchFromSameCountry(Round round)
    {
        if (round == Round.RoundOf16 || round == Round.Quarter || round == Round.SemiFinals || round == Round.Final)
        {
            return true;
        }
        return false;
    }
}
