@page "/newMatch"

@using API.Data.DTOs
@using Core.Models
@using UI.Clients

@inherits ComponentBase

@inject IDialogService DialogService
@inject MatchesClient MatchClient
@inject TeamsClient TeamsClient
@inject ISnackbar Snackbar

<MudDialog>
	<DialogContent>
		<MudForm @ref="addForm" Spacing="2">
			<MudSelect T="Competition" Label="Competition" Value="matchRes.Competition" ValueChanged="OnCompetitionChanged">
				@foreach (var c in Enum.GetValues<Competition>())
				{
					<MudSelectItem Value="@c">@c.ToString()</MudSelectItem>
				}
			</MudSelect>
			<MudSelect T="string" Label="Home Team" Value="matchRes.HomeTeamName" ValueChanged="OnHomeTeamChanged">
				@foreach (var tr in _competitionTeams)
				{
					<MudSelectItem Value="@tr.Name">@tr.Name</MudSelectItem>
				}
			</MudSelect>
			<MudSelect T="string" Label="Away Team" Value="matchRes.AwayTeamName" ValueChanged="OnAwayTeamChanged">
				@foreach (var tr in _competitionTeams)
				{
					<MudSelectItem Value="@tr.Name">@tr.Name</MudSelectItem>
				}
			</MudSelect>
			<MudSelect T="Round" Label="Round" @bind-Value="matchRes.Round">
				@foreach (var r in Enum.GetValues<Round>())
				{
					<MudSelectItem Value="@r">@r.ToString()</MudSelectItem>
				}
			</MudSelect>
		</MudForm>
	</DialogContent>
	<DialogActions>
		<MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Cancel</MudButton>
		<MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Save</MudButton>
	</DialogActions>
</MudDialog>

@code {
	private MudForm addForm = default!;
	private MatchResponse matchRes = new();
	private MatchRequest matchReq = new();

	private List<TeamResponse> _teams = new();
	private List<TeamResponse> _competitionTeams = new();

	[CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

	protected override async Task OnInitializedAsync()
	{
		var data = await TeamsClient.GetTeams() ?? Array.Empty<TeamResponse>();
		_teams = data.OrderBy(c => c.Position).ToList();
		_competitionTeams = _teams;
	}

	private void OnCompetitionChanged(Competition comp)
	{
		matchRes.Competition = comp;
		_competitionTeams = _teams.Where(t => t.Competition == comp)
										.OrderBy(t => t.Name)
										.ToList();

		matchRes.HomeTeamName = string.Empty;
		matchRes.AwayTeamName = string.Empty;
	}

	private void OnHomeTeamChanged(string homeTeam)
	{
		if (AreTeamsSame(matchRes.AwayTeamName, homeTeam) || IsCompetitionNone(matchRes.Competition) || AreTeamsCountriesSame(matchRes.AwayTeamName, homeTeam))
		{
			return;
		}
		else
		{
			matchRes.HomeTeamName = homeTeam;
		}
	}

	private void OnAwayTeamChanged(string awayTeam)
	{
		if (AreTeamsSame(matchRes.HomeTeamName, awayTeam) || IsCompetitionNone(matchRes.Competition) || AreTeamsCountriesSame(matchRes.HomeTeamName, awayTeam))
		{
			return;
		}
		else
		{
			matchRes.AwayTeamName = awayTeam;
		}
	}

	private async Task Save(MouseEventArgs args)
	{
		if (matchRes.Round <= 0)
		{
			return;
		}
		matchReq = new MatchRequest
		{
			HomeTeamName = matchRes.HomeTeamName,
			AwayTeamName = matchRes.AwayTeamName,
			Score = matchRes.Score,
			Round = matchRes.Round,
			Competition = matchRes.Competition
		};
		var success = await MatchClient.AddMatch(matchReq);

		if (success != null && success == true)
		{
			MudDialog.Close(DialogResult.Ok(matchRes));
			Snackbar.Add("Match added successfully.", Severity.Success);
		}
		else
		{
			Snackbar.Add("Failed to add match.", Severity.Error);
		}
	}

	private void Cancel(MouseEventArgs args)
	{
		MudDialog?.Close(DialogResult.Ok(matchRes));
	}

	private bool AreTeamsSame(string firstTeam, string secondTeam)
	{
		if (secondTeam.Equals(firstTeam))
		{
			Snackbar.Add("Home and Away teams cannot be the same.", Severity.Warning);
			matchRes.HomeTeamName = string.Empty;
			matchRes.AwayTeamName = string.Empty;

			return true;
		}
		return false;
	}

	private bool IsCompetitionNone(Competition comp)
	{
		if (matchRes.Competition == Competition.None)
		{
			Snackbar.Add("Please select a competition first.", Severity.Warning);
			matchRes.HomeTeamName = string.Empty;
			matchRes.AwayTeamName = string.Empty;

			return true;
		}
		return false;
	}

	private bool AreTeamsCountriesSame(string firstTeam, string secondTeam)
	{
		var team1 = _teams.First(t => t.Name == firstTeam);
		var team2 = _teams.First(t => t.Name == secondTeam);
		if (team1.CountryName.Equals(team2?.CountryName))
		{
			Snackbar.Add("Both teams cannot be from the same country.", Severity.Warning);
			matchRes.HomeTeamName = string.Empty;
			matchRes.AwayTeamName = string.Empty;
			return true;
		}

		return false;
	}
}
