@page "/newMatch"
@using API.Data.DTOs
@using Core.Models
@using UI.Clients
@inherits ComponentBase
@inject IDialogService DialogService
@inject MatchesClient MatchClient
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="addForm" Spacing="2">
            <MudTextField @bind-Value="matchRes.HomeTeamName" Label="Home Team" />
            <MudTextField @bind-Value="matchRes.AwayTeamName" Label="Away Team" />
            <MudNumericField @bind-Value="matchRes.Round" Label="Round" />
            <div style="text-align:left">
                <MudMenu Color="Color.Primary"
                         Variant="Variant.Filled"
                         Label="Competition"
                         StartIcon="@Icons.Material.Filled.Add"
                         Dense="true"
                         Class="m-1">
                    <MudMenuItem OnClick="@(args => AddCompetition(args, 1))">Champions League</MudMenuItem>
                    <MudMenuItem OnClick="@(args => AddCompetition(args, 2))">Europa League</MudMenuItem>
                    <MudMenuItem OnClick="@(args => AddCompetition(args, 3))">Conference League</MudMenuItem>
                </MudMenu>
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm addForm = default!;
    private MatchResponse matchRes = new();
    private MatchRequest matchReq = new();
    private int CompetitionId;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    protected override void OnParametersSet()
    {
    }

    private void Cancel(MouseEventArgs args)
    {
        MudDialog?.Close(DialogResult.Ok(matchRes));
    }

    private async Task Save(MouseEventArgs args)
    {
        if (matchRes.Round <= 0)
        {
            return;
        }
        matchReq = new MatchRequest
        {
            HomeTeamName = matchRes.HomeTeamName,
            AwayTeamName = matchRes.AwayTeamName,
            Score = matchRes.Score,
            Round = matchRes.Round,
            Competition = (Competition)CompetitionId
        };
        var success = await MatchClient.AddMatch(matchReq);

        if (success != null && success == true)
        {
            MudDialog.Close(DialogResult.Ok(matchRes));
            Snackbar.Add("Match added successfully.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to add match.", Severity.Error);
        }
    }

    private void AddCompetition(MouseEventArgs args, int i)
    {
        CompetitionId = i;
    }
}
