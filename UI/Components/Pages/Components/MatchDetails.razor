@using API.Data.DTOs
@using MudBlazor

@inject IDialogService DialogService

<MudDialog editForm>
    <DialogContent>
        <MudStack Row="true" Spacing="2">
            <MudTextField @bind-Value="match.HomeTeamName" Label="Home Team" />
            <MudTextField @bind-Value="match.AwayTeamName" Label="Away Team" />
            <MudTextField @bind-Value="match.Score" Label="Score" />
            <MudTextField @bind-Value="match.Round" Label="Round" />
            <MudTextField @bind-Value="match.Competition" Label="Competition" />
            <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Save</MudButton>
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
	[Parameter] public MatchResponse Match { get; set; } = default!;

	private MatchResponse match = new();
	private MudForm editForm = default!;

	protected override void OnParametersSet()
	{
		if (Match == null)
		{
			DialogService.ShowAsync<MatchDetails>("Error", new DialogParameters { ["Match"] = Match });
			return;
		}
		match = new MatchResponse
        {
            HomeTeamName = Match.HomeTeamName,
            AwayTeamName = Match.AwayTeamName,
            Score = Match.Score,
            Competition = Match.Competition,
            Round = Match.Round
        };
	}
	private void Save(MouseEventArgs args)
	{
		
	}
	private void Cancel(MouseEventArgs args)
	{
		// editForm?.
	}
}
