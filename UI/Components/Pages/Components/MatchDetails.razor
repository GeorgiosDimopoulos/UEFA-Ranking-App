@using API.Data.DTOs
@using Core.Models
@using Humanizer
@using MudBlazor
@using UI.Clients

@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject MatchesClient MatchesClient
@inject TeamsClient TeamsClient
@inject NavigationManager Navigation

<MudDialog Style="width:500px">
    <DialogContent>
        <MudStack Spacing="2">
            <MudSelect T="Competition" Label="Competition" Value="matchRes.Competition" ValueChanged="OnCompetitionChanged">
                @foreach (var c in Enum.GetValues<Competition>())
                {
                    <MudSelectItem Value="@c">@c.ToString().Humanize(LetterCasing.Title)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Home Team" @bind-Value="matchRes.HomeTeamName">
                @foreach (var t in _competitionTeams)
                {
                    <MudSelectItem Value="@t.Name">@t.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Away Team" @bind-Value="matchRes.AwayTeamName">
                @foreach (var t in _competitionTeams)
                {
                    <MudSelectItem Value="@t.Name">@t.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="matchRes.Score" Label="Score" />
            <MudSelect T="Round" Label="Round" @bind-Value="matchRes.Round">
                @foreach (var c in Enum.GetValues<Round>())
                {
                    <MudSelectItem Value="@c">@c.ToString().Humanize(LetterCasing.Title)</MudSelectItem>
                }
            </MudSelect>
            <MudStack Row="true" Spacing="1" Class="justify-end">
                <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Save</MudButton>
            </MudStack>
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public MatchResponse Match { get; set; } = default!;
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private MatchResponse matchRes = new();
    private MatchRequest matchReq = new();

    private TeamResponse[] teams = Array.Empty<TeamResponse>();
    private List<TeamResponse> _competitionTeams = new();

    protected override async Task OnInitializedAsync()
    {
        if (Match == null)
        {
            await DialogService.ShowAsync<MatchDetails>("Error", new DialogParameters { ["Match"] = Match });
            return;
        }

        teams = await TeamsClient.GetTeams() ?? Array.Empty<TeamResponse>();

        matchRes = new MatchResponse
        {
            HomeTeamName = Match.HomeTeamName,
            AwayTeamName = Match.AwayTeamName,
            Score = Match.Score,
            Competition = Match.Competition,
            Round = Match.Round,
            Id = Match.Id
        };
    }

    private void OnCompetitionChanged(Competition comp)
    {
        matchRes.Competition = comp;
        _competitionTeams = teams.Where(t => t.Competition == comp)
                                        .OrderBy(t => t.Name)
                                        .ToList();
    }

    private async Task Save(MouseEventArgs args)
    {
        matchReq = new MatchRequest
        {
            HomeTeamName = matchRes.HomeTeamName,
            AwayTeamName = matchRes.AwayTeamName,
            Score = matchRes.Score,
            Competition = matchRes.Competition,
            Round = matchRes.Round,
            Id = matchRes.Id
        };

        var result = await MatchesClient.SaveMatch(matchReq);

        if (result != null && result == true)
        {
            Snackbar.Add("Match saved successfully", Severity.Success);
            MudDialog?.Close(DialogResult.Ok(matchReq));
            switch (matchReq.Competition)
            {
                case Competition.ChampionsLeague:
                    Navigation.NavigateTo("/championsSchedule");
                    break;
                case Competition.EuropaLeague:
                    Navigation.NavigateTo("/europaSchedule");
                    break;
                case Competition.ConferenceLeague:
                    Navigation.NavigateTo("/conferenceSchedule");
                    break;
                default:
                    Navigation.NavigateTo("/");
                    break;
            }
            StateHasChanged();
        }
        else
        {
            Snackbar.Add("Error saving new match", Severity.Error);
        }
    }

    private void Cancel(MouseEventArgs args)
    {
        MudDialog?.Close(DialogResult.Ok(matchReq));
    }
}
