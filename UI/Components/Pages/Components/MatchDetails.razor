@using API.Data.DTOs
@using MudBlazor

@inject IDialogService DialogService

<MudDialog>
	<DialogContent>
		<MudForm @ref="editForm">
			<MudTextField @bind-Value="match.HomeTeamName" Label="Home Team" />
			<MudTextField @bind-Value="match.AwayTeamName" Label="Away Team" />
			<MudTextField @bind-Value="match.Result" Label="Result" />
		</MudForm>
	</DialogContent>
</MudDialog>

@code {
	[Parameter] public MatchResponse Match { get; set; } = default!;

	private MatchResponse match = new();
	private MudForm editForm = default!;

	protected override void OnParametersSet()
	{
		if (Match == null)
		{
			DialogService.ShowAsync<MatchDetails>("Error", new DialogParameters { ["Match"] = Match });
			return;
		}
		match = new MatchResponse
		{
			HomeTeamName = Match.HomeTeamName,
			AwayTeamName = Match.AwayTeamName,
			Result = Match.Result,
			Competition = Match.Competition,
			Round = Match.Round
		};
	}
}
