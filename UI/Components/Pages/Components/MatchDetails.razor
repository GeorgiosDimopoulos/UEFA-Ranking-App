@using API.Data.DTOs
@using Core.Models
@using Humanizer
@using MudBlazor

@inject IDialogService DialogService

<MudDialog editForm>
    <DialogContent>
        <MudStack Row="true" Spacing="2">
			<MudTextField @bind-Value="matchRes.HomeTeamName" Label="Home Team" />
			<MudTextField @bind-Value="matchRes.AwayTeamName" Label="Away Team" />
			<MudTextField @bind-Value="matchRes.Score" Label="Score" />
			<MudTextField @bind-Value="matchRes.Round" Label="Round" />
			<MudSelect T="Competition" Label="Competition" Value="matchRes.Competition" ValueChanged="OnCompetitionChanged">
				@foreach (var c in Enum.GetValues<Competition>())
				{
					<MudSelectItem Value="@c">@c.ToString().Humanize(LetterCasing.Title)</MudSelectItem>
				}
			</MudSelect>          
			<MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Cancel</MudButton>
			<MudButton Color="Color.Secondary" Variant=" Variant.Text" OnClick="Delete">Delete</MudButton>
            <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Save</MudButton>
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
	[Parameter] public MatchResponse Match { get; set; } = default!;

	private MatchResponse matchRes = new();
	private MudForm editForm = default!;

	protected override void OnParametersSet()
	{
		if (Match == null)
		{
			DialogService.ShowAsync<MatchDetails>("Error", new DialogParameters { ["Match"] = Match });
			return;
		}
		matchRes = new MatchResponse
        {
            HomeTeamName = Match.HomeTeamName,
            AwayTeamName = Match.AwayTeamName,
            Score = Match.Score,
            Competition = Match.Competition,
            Round = Match.Round
        };
	}
	private void Save(MouseEventArgs args)
	{
		
	}
	private void Cancel(MouseEventArgs args)
	{
		// editForm?.
	}

	private void Delete(MouseEventArgs args)
	{
	}

	private void OnCompetitionChanged(Competition comp)
	{
		matchRes.Competition = comp;
	}
}
