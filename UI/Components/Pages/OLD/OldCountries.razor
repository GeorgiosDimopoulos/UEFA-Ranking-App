@page "/oldcountries"
@using Core.Interfaces
@using Core.Models
@using Infrastructure
@using Infrastructure.DataAccess

<PageTitle>Countries Statistics</PageTitle>

<div class="alert alert-info">This component demonstrates showing countries football statistics data for 2025 - 2026</div>

<div>
    @if (countries == null)
    {
        <p><em>Loading countries...</em></p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Country</th>
                    <th class="text-center" colspan="1">Position</th>
                    <th class="text-center" colspan="5">Teams</th>
                </tr>
                <tr>
                    <th>Name</th>
                    <th>Initial</th>
                    <th>Active</th>
                    <th>Points</th>
                    <th>Initial</th>
                    <th>Active</th>
                    <th>Show Teams</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in countries)
                {
                    <tr>
                        <MudButton @onclick="OpenCountryAsync" Variant="Variant.Filled" Color="Color.Primary">@c.Name</MudButton>
                        <td>@c.Position</td>
                        <td>@c.Position</td>
                        <td>@c.TotalPoints</td>
                        <td>
                            <input type="checkbox" @onclick="() => ToggleTeamId(c.Name)" />
                        </td>
                    </tr>
                    <tr>
                        @if (countryTeams.TryGetValue(c.Id, out var teams) && expanded.Contains(c.Name))
                        {
                            foreach (var t in teams)
                            {
                                <_CountryTeamComponent CountryName="@c.Name"></_CountryTeamComponent>
                                <td colspan="7">@t.Name with @t.Points points</td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private Country[]? countries;
    private Dictionary<int, Team[]> countryTeams = default!;
    private HashSet<string> expanded = new();
    private bool shownTeams;
    private ICountryRepository countryRepository = default!;
    private ITeamRepository teamRepository = default!;

    private IConfiguration configuration = default!;

    protected override async Task OnInitializedAsync()
    {
        countryRepository = new CountryRepository(configuration);
        await Task.Delay(500);
        countries = (await countryRepository.GetAllCountries()).ToArray();
        var allTeams = await teamRepository.GetAllTeams();

        countryTeams = allTeams.GroupBy(t => t.CountryId).ToDictionary(g => g.Key, g => g.ToArray());
    }

    private void ToggleTeamId(string n)
    {
        if (!expanded.Add(n))
            expanded.Remove(n);
    }

    private Task OpenCountryAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        return Task.CompletedTask;
    }
}