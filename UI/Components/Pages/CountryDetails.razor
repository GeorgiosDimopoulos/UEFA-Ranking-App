@page "/countries/{Id:guid}"

@inherits ComponentBase
@inject IDialogService DialogService
@using API.Data.DTOs
@using MudBlazor

<MudDialog>
	<DialogContent>
		<MudForm @ref="editForm">
			<MudTextField @bind-Value="country.Name" Label="Name" />
			<MudNumericField T="int" ReadOnly="true" HideSpinButtons="true" @bind-Value="country.Position" Label="Initial Position" />
			<MudNumericField T="int" @bind-Value="country.Position" Label="Current Position" />
			<MudNumericField T="int" ReadOnly="true" HideSpinButtons="true" Value="country.NumberOfInitialTeams" Label="Initial Teams" />
			<MudNumericField T="int" Value="country.NumberOfActiveTeams" Label="Active Teams" />
			<MudNumericField T="int" @bind-Value="country.TotalPoints" Label="Total Points" />
		</MudForm>
	</DialogContent>
	<DialogActions>
		<MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
		<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[Parameter] public CountryResponse Country { get; set; } = default!;
	[CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

	private MudForm editForm = default!;
	private CountryResponse country = new();

	protected override void OnParametersSet()
	{
		country = new CountryResponse
		{
			Position = Country.Position,
			Name = Country.Name,
			TotalPoints = Country.TotalPoints
		};
	}

	private void Save()
	{
		var options = new DialogOptions { CloseOnEscapeKey = true };
		MudDialog?.Close(DialogResult.Ok(country));
	}

	private void Cancel()
	{
		MudDialog?.Close(DialogResult.Ok(country));
	}
}