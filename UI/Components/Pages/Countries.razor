@page "/countries"
@using Core.Models
@using Infrastructure
@using Infrastructure.DataAccess

<PageTitle>Countries Statistics</PageTitle>

<div class="alert alert-info">This component demonstrates showing countries football statistics data for 2025 - 2026</div>

<div>
	@if (countries == null)
	{
		<p><em>Loading countries...</em></p>
	}
	else
	{
		<MudTable Items="countries">
			<HeaderContent>
				<MudTh>Id</MudTh>
				<MudTh>Name</MudTh>
				<MudTh>Initial Position</MudTh>
				<MudTh>Active Position</MudTh>
				<MudTh>Initial Points</MudTh>
				<MudTh>Active Points</MudTh>
				<MudTh>Teams Number</MudTh>
				<MudTh>Show Teams</MudTh>
			</HeaderContent>
			<RowTemplate>
				<MudTd>@context.ExternalId</MudTd>
				<MudTd>
					<NavLink class="nav-link" href=@($"/countries/{context.Id}") style="text-decoration:underline">@context.Name</NavLink>
				</MudTd>
				<MudTd>@context.Position</MudTd>
				<MudTd>@context.Position</MudTd>
				<MudTd>@context.TotalPoints</MudTd>
				<MudTd>@context.TotalPoints</MudTd>
				<MudTd>@context.NumberOfTeams</MudTd>
				<MudTd>
					@* <MudCheckBox @onclick="@(() => ToggleTeamId(context.ExternalId))" /> *@
					<MudButton Color="Color.Success"
							   Variant="Variant.Filled"
							   Style="min-width:40px; width:40px; height:30px; padding:0;"
							   OnClick="@(() => ToggleTeamId(context.ExternalId))">
						<MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" />
					</MudButton>
				</MudTd>
			</RowTemplate>
		</MudTable>
	}
</div>

@code {
	private Country[]? countries;
	private HashSet<int> expanded = new();
	private bool shownTeams;

	protected override async Task OnInitializedAsync()
	{
		await Task.Delay(500);
		var databasefeeder = new DatabaseFeeder();
		countries = databasefeeder.GetCountries();
	}

	private void ToggleTeamId(int id)
	{
		if (!expanded.Add(id))
			expanded.Remove(id);
	}

	private Task OpenCountryAsync()
	{
		var options = new DialogOptions { CloseOnEscapeKey = true };

		return Task.CompletedTask;
	}
}