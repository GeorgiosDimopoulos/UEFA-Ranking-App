@page "/statistics"
@using API.Data.DTOs
@using Core.Models
@using Humanizer
@using UI.Clients
@using UI.Components.Pages.Components
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web

@inject IDialogService DialogService
@inject TeamsClient TeamsClient

<PageTitle>Greek Statistics</PageTitle>

<MudPaper Class="pa-6" Elevation="0" Style="background-color:#f9fafb;">
    <MudContainer Class="py-6 statistics-page">
        <MudText Typo="Typo.h5" Class="mb-4">Greek Teams Stats:</MudText>
        <MudGrid GutterSize="2" Class="mt-2">
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="4" Square="false" Class="pa-4"
                          Style="background-color:white; border-radius:10px; height:100%; border:1px solid #000;">
                    <MudButton Variant="Variant.Text"
                               Class="px-0 text-start"
                               Style="font-size:1.25rem; font-weight:500; text-decoration:underline; text-decoration-color:blue"
                               OnClick="() => OpenTeamMatchesAsync(aek)">
                        @aek?.Name.Humanize(LetterCasing.Title)
                    </MudButton>
                    <MudDivider Class="my-2" DividerType="DividerType.Middle" Color="Color.Primary" />
                    <MudText Class="mb-1">Position: @aek?.Position</MudText>
                    <MudText Class="mb-1">Matches: @aek?.MatchesPlayed</MudText>
                    <MudText Class="mb-1">Points: @aek?.Points</MudText>
                    <MudText Class="mb-1">Competition: @aek?.Competition.Humanize(LetterCasing.Title)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="4" Square="false" Class="pa-4"
                          Style="background-color:white; border-radius:10px; height:100%; border:1px solid #000;">
                    <MudButton Variant="Variant.Text"
                               Class="px-0 text-start"
                               Style="font-size:1.25rem; font-weight:500; text-decoration:underline; text-decoration-color:blue"
                               OnClick="() => OpenTeamMatchesAsync(osfp)">
                        @osfp?.Name.Humanize(LetterCasing.Title)
                    </MudButton>
                    <MudDivider Class="my-2" DividerType="DividerType.Middle" Color="Color.Primary" />
                    <MudText Class="mb-1">Position: @osfp?.Position</MudText>
                    <MudText Class="mb-1">Matches: @osfp?.MatchesPlayed</MudText>
                    <MudText Class="mb-1">Points: @osfp?.Points</MudText>
                    <MudText Class="mb-1">Competition: @osfp?.Competition.Humanize(LetterCasing.Title)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="4" Square="false" Class="pa-4"
                          Style="background-color:white; border-radius:10px; height:100%; border:1px solid #000;">
                    <MudButton Variant="Variant.Text"
                               Class="px-0 text-start"
                               Style="font-size:1.25rem; font-weight:500; text-decoration:underline; text-decoration-color:blue"
                               OnClick="() => OpenTeamMatchesAsync(pao)">
                        @pao?.Name.Humanize(LetterCasing.Title)
                    </MudButton>				
                    <MudDivider Class="my-2" DividerType="DividerType.Middle" Color="Color.Primary" />
                    <MudText Class="mb-1">Position:@pao?.Position</MudText>
                    <MudText Class="mb-1">Matches:@pao?.MatchesPlayed</MudText>
                    <MudText Class="mb-1">Points:@pao?.Points</MudText>
                    <MudText Class="mb-1">Competition:@pao?.Competition.Humanize(LetterCasing.Title)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="4" Square="false" Class="pa-4"
                          Style="background-color:white; border-radius:10px; height:100%; border:1px solid #000;">
                    <MudButton Variant="Variant.Text"
                               Class="px-0 text-start"
                               Style="font-size:1.25rem; font-weight:500; text-decoration:underline; text-decoration-color:blue"
                               OnClick="() => OpenTeamMatchesAsync(paok)">
                        @paok?.Name.Humanize(LetterCasing.Title)
                    </MudButton>				
                    <MudDivider Class="my-2" DividerType="DividerType.Middle" Color="Color.Primary" />
                    <MudText Class="mb-1">Position: @paok?.Position</MudText>
                    <MudText Class="mb-1">Matches: @paok?.MatchesPlayed</MudText>
                    <MudText Class="mb-1">Points: @paok?.Points</MudText>
                    <MudText Class="mb-1">Competition: @paok?.Competition.Humanize(LetterCasing.Title)</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudPaper>

@code {
    private TeamResponse aek = new(), osfp = new(), pao = new(), paok = new();

    protected override async Task OnInitializedAsync()
    {
        TeamResponse[]? greekTeams = await TeamsClient.GetTeams();
        if (greekTeams != null && !greekTeams.Any())
        {
            return;
        }

        aek = greekTeams!.FirstOrDefault(t => t.Name.Equals("AEK"))!;
        pao = greekTeams!.FirstOrDefault(t => t.Name.Equals("Panathinaikos"))!;
        paok = greekTeams!.FirstOrDefault(t => t.Name.Equals("PAOK"))!;
        osfp = greekTeams!.FirstOrDefault(t => t.Name.Equals("Olympiacos"))!;

        StateHasChanged();
    }

    private async Task OpenTeamMatchesAsync(TeamResponse team)
    {
        var parameters = new DialogParameters { ["Team"] = team };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await DialogService.ShowAsync<TeamMatches>("Team Matches", parameters, options);

        var result = await dialog.Result;
    }

}
