@page "/conferenceSchedule"

@using API.Data.DTOs
@using Core.Models
@using Humanizer
@using UI.Clients
@using UI.Components.Pages.Components

@inject MatchesClient MatchesClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<h3>Schedule</h3>

<div>
	@if (_allMatches is null)
	{
		<p><em>Loading Matches...</em></p>
	}
	else
	{
		<div class="d-flex justify-content-center mb-3 align-items-center">
			<MudButton Style="text-decoration:underline" OnClick="@PreviousRound">PREVIOUS</MudButton>
			<MudText Style="font-weight:bold; text-align:center;" bind-value="@_round">@_round</MudText>
			<MudButton Style="text-decoration:underline" OnClick="@NextRound">NEXT</MudButton>
		</div>
		<MudTable Items="_roundMatches">
			<HeaderContent>
				<MudTh Style="font-weight:bold;">Home Team</MudTh>
				<MudTh Style="font-weight:bold;">Away Team</MudTh>
				<MudTh Style="font-weight:bold;">Score</MudTh>
				<MudTh Style="font-weight:bold;">Competition</MudTh>
				<MudTh Style="font-weight:bold;">Edit</MudTh>
				<MudTh Style="font-weight:bold;">Delete</MudTh>
			</HeaderContent>
			<RowTemplate>
				<MudTd>@context.HomeTeamName</MudTd>
				<MudTd>@context.AwayTeamName</MudTd>
				<MudTd>
					@if (@context.Score is null)
					{
						@string.Empty
					}
					else
					{
						@context.Score
					}
				</MudTd>
				<MudTd>@context.Competition.ToString().Humanize(LetterCasing.Title)</MudTd>
				@* <MudTd>@((int)context.Round)</MudTd> *@
				<MudTd Style="vertical-align: middle;">
					<MudButton Class="p-0"
							   Color="Color.Success"
							   Variant="Variant.Filled"
							   Style="min-width:40px; width:40px; height:30px; display:flex;"
							   OnClick="() => EditMatch(context)">
						<MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
					</MudButton>
				</MudTd>
				<MudTd Style="vertical-align: middle;">
					<MudButton Color="Color.Error"
							   Variant="Variant.Filled"
							   Style="min-width:40px; width:40px; height:30px; display:flex;"
							   OnClick="@(() => DeleteMatchAsync(context))">
						<MudIcon Icon="@Icons.Material.Filled.Delete" />
					</MudButton>
				</MudTd>
			</RowTemplate>
		</MudTable>
	}
</div>

@code {
	private string _round => "Round: " + _roundNumber;
	private int _roundNumber = 1;

	private List<MatchResponse> _allMatches = default!;
	private List<MatchResponse> _cupMatches = default!;
	private List<MatchResponse> _roundMatches = default!;

	protected override async Task OnInitializedAsync()
	{
		_allMatches = await MatchesClient.GetMatches() ?? new();
		_cupMatches = _allMatches.Where(m => m.Competition == Competition.ConferenceLeague).ToList();

		_roundMatches = _cupMatches.Where(m => (int)m.Round == 1).ToList();
	}

	private void NextRound()
	{
		_roundNumber += 1;
		_roundMatches = _cupMatches.Where(m => ((int)m.Round) == _roundNumber).ToList();

		StateHasChanged();
	}

	private void PreviousRound()
	{
		if (_round.Equals("Round: 1"))
		{
			// _round = "All rounds";
			return;
		}

		_roundMatches = _cupMatches.Where(m => ((int)m.Round) == _roundNumber).ToList();

		StateHasChanged();
	}

	private async Task DeleteMatchAsync(MatchResponse m)
	{
		bool? confirmation = await DialogService.ShowMessageBox("Confirm Delete", "Are you sure you want to delete the match?", yesText: "Delete", cancelText: "Cancel");

		if (confirmation == true)
		{
			var result = await MatchesClient.DeleteMatch(m.Id);
			if (result != null && result == true)
			{
				Snackbar.Add($"Match deleted successfully.", Severity.Success);
			}
			else
			{
				Snackbar.Add($"Failed to delete Match", Severity.Error);
			}
		}

		await OnInitializedAsync();
	}

	private async Task EditMatch(MatchResponse match)
	{
		var parameters = new DialogParameters { ["Match"] = match };
		var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

		var dialog = await DialogService.ShowAsync<MatchDetails>("Edit Match", parameters, options);

		var result = await dialog.Result;
		if (result != null && !result!.Canceled && result.Data is MatchResponse mr)
		{
			var index = _cupMatches.FindIndex(m => m.Id == mr.Id);
			if (index != -1)
			{
				_cupMatches[index] = mr;
				StateHasChanged();
			}
		}
	}
}
