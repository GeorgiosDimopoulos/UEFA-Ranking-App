@using API.Data.DTOs
@using UI.Components.Pages.Components
@inherits LayoutComponentBase

@inject IDialogService DialogService
@inject NavigationManager Nav

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<div class="page">
    @* <div class="sidebar">
        <NavMenu />
    </div>     *@
    <main>
        <MudTabs Color="Color.Primary" Rounded="true" Elevation="2" Centered="true" Class="mb-2" FullWidth="true" OnActivePanelIndexChanged="OnTabChanged">
            <MudTabPanel Text="Matches" Icon="@Icons.Material.Filled.Event" />
            <MudTabPanel Text="Countries" Icon="@Icons.Material.Filled.Flag" />
            <MudTabPanel Text="Teams" Icon="@Icons.Material.Filled.EmojiEvents" />
            <MudTabPanel Text="Statistics" Icon="@Icons.Material.Filled.Insights" />
        </MudTabs>
        <div class="top-row px-4">
            <MudMenu Color="Color.Primary"
                     Variant="Variant.Filled"
                     Label="Add"
                     StartIcon="@Icons.Material.Filled.Add"
                     Dense="true"
                     Class="m-2">
                <MudMenuItem StartIcon="@Icons.Material.Filled.Add" OnClick="AddCountry">Add Country</MudMenuItem>
                <MudMenuItem StartIcon="@Icons.Material.Filled.Add" OnClick="AddTeam">Add Team</MudMenuItem>
                <MudMenuItem StartIcon="@Icons.Material.Filled.Add" OnClick="AddMatch">Add Match</MudMenuItem>
            </MudMenu>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    void OnTabChanged(int i)
    {
        var routes = new[] { "schedule", "countries", "teams", "statistics" };
        Nav.NavigateTo(routes[i]);
    }

    private async Task AddCountry()
    {
        var dialogRef = await DialogService.ShowAsync<AddCountry>("Add Country", new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialogRef.Result;
        if (result != null && !result!.Canceled && result.Data is CountryResponse updatedCountry)
        {
            // Countries.Add(newCountry);
            StateHasChanged();
        }
    }

    private async Task AddTeam()
    {
        var dialogRef = await DialogService.ShowAsync<AddTeam>("Add Team", new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialogRef.Result;
        if (result != null && !result!.Canceled && result.Data is TeamResponse updatedCountry)
        {
            StateHasChanged();
        }
    }

    private async Task AddMatch()
    {
        var dialogRef = await DialogService.ShowAsync<AddMatch>("Add Match", new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialogRef.Result;
        if (result != null && !result!.Canceled && result.Data is MatchResponse updatedCountry)
        {
            StateHasChanged();
        }
    }
}