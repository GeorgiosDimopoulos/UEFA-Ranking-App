@inherits LayoutComponentBase

<div class="page">
	<div class="sidebar">
		<NavMenu />
	</div>

	<main>
		<div class="top-row px-4">
			<input type="button" class="btn btn-success" style="width:100px" value="Add" @onclick="AddNewEntity()" />
		</div>
		<article class="content px-4">
			@Body
		</article>
	</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
	An unhandled error has occurred.
	<a href="." class="reload">Reload</a>
	<span class="dismiss">🗙</span>
</div>

@code {
	private EventCallback<MouseEventArgs> AddNewEntity()
	{
		return EventCallback.Factory.Create<MouseEventArgs>(this, () => Console.WriteLine("Add new entity"));
	}
}