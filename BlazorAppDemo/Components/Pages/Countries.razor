@page "/countries"
@using Core.Data.Models
@using Core.DataAccess

<PageTitle>Countries</PageTitle>

<div class="alert alert-info">Countries Statistics</div>

<div>
	<p>This component demonstrates showing countries data.</p>

	@if (countries == null)
	{
		<p><em>Loading countries...</em></p>
	}
	else
	{
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Name</th>
					<th>Initial Position</th>
					<th>Active Position</th>
					<th>Initial Teams</th>
					<th>Active Teams</th>
					<th>Total Points</th>
					<th>Show Teams</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var c in countries)
				{
					<tr>
						<td>@c.Name</td>
						<td>@c.Position</td>
						<td>@c.Position</td>
						<td>@c.NumberOfTeams</td>
						<td>@c.NumberOfTeams</td>
						<td>@c.TotalPoints</td>
						<td>
							<input type="checkbox" @onclick="() => ToggleTeamId(c.Id)" />
						</td>
					</tr>
					<tr>
						@if (c.Teams.Count() > 0 && expanded.Contains(c.Id))
						{
							@foreach (var t in c.Teams)
							{
								@* <_CountryTeamComponent CountryName="@c.Name"></_CountryTeamComponent> *@
								<td colspan="7">@t.Name with @t.Points points</td>
							}
						}
					</tr>
				}
			</tbody>
		</table>
	}
</div>

@code {
	private Country[]? countries;
	private HashSet<int> expanded = new();
	private bool shownTeams;

	protected override async Task OnInitializedAsync()
	{
		await Task.Delay(500);
		var databasefeeder = new Databasefeeder();
		countries = databasefeeder.GetCountries();
	}

	private void ToggleTeamId(int id)
	{
		if (!expanded.Add(id))
			expanded.Remove(id);
	}
}
