@page "/learnBlazor/bindprop"

<div class="row">
	<div class="col-6 border p-3">
		<h4>Product - Data Info</h4>
		Name : @product.Name
		<br />
		Current Price : @product.Price
		<br />
		The product is : @(product.IsActive ? "Active" : "Inactive")
		<br />
	</div>
	<div class="col-6 border p-3">
		<h4>Product - Data Binding</h4>
		IsActive:
		<input type="checkbox" @bind="@product.IsActive" />
		<br />

		Input price :
		<input type="number" @bind="@product.Price" @bind:event="oninput" />
		<br />

		Select a product property:
		<select @bind="selectedProp">
			@foreach (var prop in product.ProductProperties)
			{
				<option value="@prop.Key">@prop.Key</option>
			}
		</select>
		<br />
		@if (!string.IsNullOrEmpty(@selectedProp))
		{
			<p>Selected product property value: @product.ProductProperties.FirstOrDefault(pr => pr.Key.Equals(selectedProp)).Value</p>
		}
	</div>

	<div class="col-12 p4">
		<h4 class="text-success">Product Table</h4>
		<div class="row">
			<table class="table table-striped">
				<thead>
					<tr>
						<td>Product Name</td>
						<td>Price</td>
						<td>Active?</td>
					</tr>
				</thead>
				<tbody>
					@foreach (var pr in products)
					{
						<tr>
							<td> <input type="text" @bind="pr.Name" @bind:event="oninput"/> </td>
							<td> <input type="text" @bind="pr.Price" @bind:event="oninput"/> </td>
							<td> <input type="checkbox" @bind="pr.IsActive"/> </td>
						</tr>
						<tr></tr>
						<tr></tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@code {
	private string selectedProp = string.Empty;
	private string selectedPropValue = string.Empty;

	List<Product> products = new();

	Product product = new()
	{
		Name = "Product 1",
		IsActive = false,
		Id = 1,
		Price = 5,
		ProductProperties = new List<Product_Prop>()
		{
			new() { Id = 1, Key = "Color", Value = "Red" },
			new() { Id = 1, Key = "Size", Value = "20oz" },
			new() { Id = 1, Key = "Flavor", Value = "Rose" }
		}
	};

	protected override void OnInitialized()
	{
		base.OnInitialized();

		products.Add(new()
		{
			Name = "Product 1",
			IsActive = false,
			Id = 1,
			Price = 5,
			ProductProperties = new List<Product_Prop>()
			{
				new() { Id = 1, Key = "Color", Value = "Red" },
				new() { Id = 1, Key = "Size", Value = "20oz" },
				new() { Id = 1, Key = "Flavor", Value = "Rose" }
			}
		});
		products.Add(new()
		{
			Name = "Product 2",
			IsActive = true,
			Id = 2,
			Price = 10,
			ProductProperties = new List<Product_Prop>()
			{
				new() { Id = 1, Key = "Color", Value = "Blue" },
				new() { Id = 1, Key = "Size", Value = "32oz" },
				new() { Id = 1, Key = "Flavor", Value = "Ocean" }
			}
		});
	}
}