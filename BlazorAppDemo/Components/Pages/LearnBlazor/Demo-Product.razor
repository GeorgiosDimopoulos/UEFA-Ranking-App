@page "/learnBlazor/demo-product"

<h2 class="text-primary">DemoProduct</h2>

<div class="p-2 mt-2">
	<div class="row">
		@foreach (var prod in products)
		{
			<div class="bg-light border col-6">
				<h4 class="text-secondary">Product - @prod.Id</h4>
				Name - @prod.Name <br />
				Show properties:
				<input type="checkbox" @bind="prod.IsActive" />
				@if (prod.IsActive)
				{
					@foreach (var prop in prod.ProductProperties)
					{
						<p>@prop.Key - @prop.Value</p>
					}
				}
				<br />
				<_DeleteButtonComponent ProductId="@prod.Id" ProductName="@prod.Name" />
			</div>
		}
	</div>
	<div class="row pt-4">
		Count : @count
		<br />
		<input type="button" class="btn btn-success" style="width:100px" value="Count" @* @onclick="() => IncreaseCount(5)"  *@/>
	</div>
</div>

@code {
	private string selectedProp = string.Empty;
	private string selectedPropValue = string.Empty;
	private int count { get; set; } = 0;

	List<Product> products = new();

	Product product = new()
	{
		Name = "Test product 1",
		IsActive = false,
		Id = 1,
		Price = 5,
		ProductProperties = new List<Product_Prop>()
		{
			new() { Id = 1, Key = "Color", Value = "Red" },
			new() { Id = 1, Key = "Size", Value = "20oz" },
			new() { Id = 1, Key = "Flavor", Value = "Rose" }
		}
	};

	protected override void OnInitialized()
	{
		base.OnInitialized();

		products.Add(new()
		{
			Name = "Test product 1",
			IsActive = false,
			Id = 1,
			Price = 5,
			ProductProperties = new List<Product_Prop>()
			{
				new() { Id = 1, Key = "Color", Value = "Red" },
				new() { Id = 1, Key = "Size", Value = "20oz" },
				new() { Id = 1, Key = "Flavor", Value = "Rose" }
			}
		});
		products.Add(new()
		{
			Name = "Test Product 2",
			IsActive = true,
			Id = 2,
			Price = 10,
			ProductProperties = new List<Product_Prop>()
			{
				new() { Id = 1, Key = "Color", Value = "Blue" },
				new() { Id = 1, Key = "Size", Value = "32oz" },
				new() { Id = 1, Key = "Flavor", Value = "Ocean" }
			}
		});
	}

	// private void IncreaseCount(int incr)
	// {
	// 	count += incr;
	// }
}
