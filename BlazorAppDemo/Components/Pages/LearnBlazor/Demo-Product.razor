@page "/learnBlazor/demo-product"

<h2 class="text-primary">Demo Product</h2>

<div class="border p-2 mt-2 bg-secondary">
	<div class="row">
		@foreach (var prod in products)
		{
			<div class="bg-light border m-1 col-5"></div>
		}
	</div>
	<div class="row">
	</div>
</div>

@code {
	private string selectedProp = string.Empty;
	private string selectedPropValue = string.Empty;

	List<Product> products = new();

	Product product = new()
	{
		Name = "Product 1",
		IsActive = false,
		Id = 1,
		Price = 5,
		ProductProperties = new List<Product_Prop>()
		{
			new() { Id = 1, Key = "Color", Value = "Red" },
			new() { Id = 1, Key = "Size", Value = "20oz" },
			new() { Id = 1, Key = "Flavor", Value = "Rose" }
		}
	};

	protected override void OnInitialized()
	{
		base.OnInitialized();

		products.Add(new()
		{
			Name = "Product 1",
			IsActive = false,
			Id = 1,
			Price = 5,
			ProductProperties = new List<Product_Prop>()
			{
				new() { Id = 1, Key = "Color", Value = "Red" },
				new() { Id = 1, Key = "Size", Value = "20oz" },
				new() { Id = 1, Key = "Flavor", Value = "Rose" }
			}
		});
		products.Add(new()
		{
			Name = "Product 2",
			IsActive = true,
			Id = 2,
			Price = 10,
			ProductProperties = new List<Product_Prop>()
			{
				new() { Id = 1, Key = "Color", Value = "Blue" },
				new() { Id = 1, Key = "Size", Value = "32oz" },
				new() { Id = 1, Key = "Flavor", Value = "Ocean" }
			}
		});
	}
}
