@page "/teams"
@using Core.Data.Models
@using Humanizer

<PageTitle>Teams</PageTitle>

<div class="col-12">
	<p>This component demonstrates showing teams data.</p>

	@if (teams == null)
	{
		<p><em>Loading teams...</em></p>
	}
	else
	{
		<table class="table">
			<thead>
				<tr>
					<th>Id</th>
					<th>Name</th>
					<th>Country</th>
					<th>Competition</th>
					<th>Points</th>
					<th>Position</th>
					<th>Is Active?</th>
					<th>Matches:</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var team in teams)
				{
					<tr>
						<td>@team.Id</td>
						<td>@team.Name</td>
						<td>@team.Country.Name</td>
						<td>@team.Competition.ToString().Humanize(LetterCasing.Title)</td>
						<td><input type="number" @bind=@team.Points style="width:40px;" disabled="@(team.IsActive == false)" /></td>
						<td>@team.Position</td>
						<td><input type="checkbox" @bind="@team.IsActive" /></td>
						<td><input type="button" class="btn btn-success" style="width:40px" value=">" onclick="ShowMatches()"/></td>
					</tr>
					<tr></tr>
				}
			</tbody>
		</table>
	}

</div>

@code
{
	private Team[]? teams;

	protected override async Task OnInitializedAsync()
	{
		await Task.Delay(500);
		teams = new[]
		{
			new Team
			{
				Name = "AEK",
				Competition = Competition.ConferenceLeague,
				Country = new Country() { Name = "Greece", Id = 1 },
				IsActive = true,
				Id = 1,
				Points = 2

			},
			new Team
			{
				Name = "Vfb",
				Competition = Competition.EuropaLeague,
				Country = new Country() { Name = "Germany", Id = 2 },
				IsActive = false,
				Id = 2,
				Points = 0
			}   ,
			new Team
			{
				Name = "Sevilla",
				Competition = Competition.None,
				Country = new Country() { Name = "Spain", Id = 4 },
				IsActive = false,
				Id = 2,
				Points = 0
			}
		};
	}

	public void ShowMatches()
	{
		
	}
}
