@page "/teams"
@using Core.Models
@using Humanizer
@using Infrastructure.DataAccess

<PageTitle>Teams</PageTitle>

<div class="col-12">
	<div class="alert alert-info">This component demonstrates showing teams data.</div>

	@if (teams == null)
	{
		<p><em>Loading teams...</em></p>
	}
	else
	{
		<table class="table">
			<thead>
				<tr>
					<th>Id</th>
					<th>Name</th>
					<th>Country</th>
					<th>Competition</th>
					<th>Points</th>
					<th>Position</th>
					<th>Is Active?</th>
					<th>Matches:</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var team in teams)
				{
					<tr>
						<td>@team.Id</td>
						<td>@team.Name</td>
						<td>@team.Country.Name</td>
						<td>@team.Competition.ToString().Humanize(LetterCasing.Title)</td>
						<td>@team.Position</td>
						<td><input type="number" @bind=@team.Points style="width:40px;" disabled="@(team.IsActive == false)" /></td>
						<td><input type="checkbox" @bind="@team.IsActive" /></td>
						<td><input type="button" class="btn btn-success" style="width:40px" value=">" @onclick="ShowMatches" /></td>
					</tr>
					<tr></tr>
				}
			</tbody>
		</table>
	}

</div>

@code
{
	private Team[]? teams;

	protected override async Task OnInitializedAsync()
	{
		await Task.Delay(500);
		var databasefeeder = new Databasefeeder();
		teams = databasefeeder.GetTeams();
	}

	public void ShowMatches()
	{
	}
}
