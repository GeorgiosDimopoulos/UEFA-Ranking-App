@page "/teams"

<PageTitle>Teams</PageTitle>

<h4>My favourite Teams</h4>
<div class="col-6">
	<p>This component demonstrates showing a team's data.</p>

	@if (teams == null)
	{
		<p><em>Loading teams...</em></p>
	}
	else
	{
		<table class="table">
			<thead>
				<tr>
					<th>Id</th>
					<th>Name</th>
					<th>Country</th>
					<th>Points</th>
					<th>Is Active?</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var team in teams)
				{
					<tr>
						<td>@team.Id</td>
						<td>@team.Name</td>
						<td>@team.Country.Name</td>
						<td><input type="number" @bind=@team.Points style="width:40px;" disabled="@(team.IsActive == false)"/></td>
						<td><input type="checkbox" @bind="@team.IsActive" /></td>
					</tr>
				}
			</tbody>
		</table>
	}

</div>

@code
{
	private Team[]? teams;

	protected override async Task OnInitializedAsync()
	{
		await Task.Delay(500);
		teams = new[]
		{
			new Team
			{
				Name = "AEK",
				Country = new Country() { Name = "Greece", Id = 1 },
				IsActive = true,
				Id = 1,
				Points = 2

			},
			new Team
			{
				Name = "Vfb",
				Country = new Country() { Name = "Germany", Id = 2 },
				IsActive = false,
				Id = 2,
				Points = 0
			}   ,
			new Team
			{
				Name = "Sevilla",
				Country = new Country() { Name = "Spain", Id = 4 },
				IsActive = false,
				Id = 2,
				Points = 0
			}
		};
	}
}
