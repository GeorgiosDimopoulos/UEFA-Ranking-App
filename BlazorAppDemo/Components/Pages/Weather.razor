@page "/weather"
@using BlazorAppDemo.Models

<PageTitle>Teams</PageTitle>

<h1>TEAM</h1>

<p>This component demonstrates showing data.</p>

@if (teams == null)
{
	<p><em>Loading...</em></p>
}
else
{
	<table class="table">
		<thead>
			<tr>
				<th>Name</th>
				<th>ID</th>
				<th>Points</th>
				<th>Active?</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var team in teams)
			{
				<tr>
					<td>@team.Name</td>
					<td>@team.Id</td>
					<td>@team.Points</td>
					<td>@team.IsActive</td>
				</tr>
			}
		</tbody>
	</table>
}

@code
{
	private Team[]? teams;

	protected override async Task OnInitializedAsync()
	{
		await Task.Delay(500);
		teams = Enumerable.Range(1, 1).Select(index => new Team
		{
			Name = "AEK",
			IsActive = true,
			Id = 1,
			Points = 2
		}).ToArray();
	}
}
